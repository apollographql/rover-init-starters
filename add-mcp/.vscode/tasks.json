{
  "version": "2.0.0",
  "tasks": [
    {
      // Run: Cmd/Ctrl+Shift+P → "Tasks: Run Task" → "Start MCP Server"
      // Starts GraphQL API (4000) + MCP Server (8000) together
      // rover dev loads .env automatically (variables already set in your shell win)
      "label": "Start MCP Server",
      "command": "rover",
      "args": [
        "dev",
        "--supergraph-config",
        "supergraph.yaml",
        "--router-config",
        "router.yaml",
        "--mcp",
        ".apollo/mcp.local.yaml"
      ],
      "type": "shell"
    },
    {
      // Opens MCP inspector UI in browser to test your AI tools
      "label": "Test MCP Tools",
      "command": "npx",
      "args": ["@modelcontextprotocol/inspector", "--transport", "http", "--server-url", "http://localhost:8000/mcp"],
      "type": "shell"
    }
  ]
}